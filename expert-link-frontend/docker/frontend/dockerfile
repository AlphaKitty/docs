# # COPY ./jar/expert-link-backend-1.0.0.jar /expert-link-backend-1.0.0.jar
# # # 启动系统服务
# # ENTRYPOINT ["java","-jar","expert-link-backend-1.0.0.jar"]
#
#
# # 多阶段构建
# # 阶段1：构建阶段（可选，如果已经在 Jenkins 中构建好了）
# FROM node:16-alpine AS builder
# WORKDIR /app
# COPY package*.json ./
# RUN npm install --registry=https://registry.npmmirror.com
# COPY . .
# RUN npm run build
#
# # 阶段2：运行阶段
# FROM nginx:alpine
# # 复制构建产物
# COPY --from=builder /app/dist /usr/share/nginx/html
# # 如果不需要多阶段，直接复制本地构建的 dist
# # COPY dist /usr/share/nginx/html
#
# # 复制 nginx 配置（如果有自定义配置）
# # COPY nginx.conf /etc/nginx/nginx.conf
#
# # 暴露端口
# EXPOSE 80
#
# # 启动 nginx
# CMD ["nginx", "-g", "daemon off;"]
